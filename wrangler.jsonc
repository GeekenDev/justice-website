{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.mjs",
  "name": "doj-files",
  // Set this to today's date
  "compatibility_date": "2026-02-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://justice.geeken.dev",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "env": {
    "preview": {
      "name": "doj-files-preview",
      "vars": {
        "SITE_URL": "https://preview.justice.geeken.dev",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "f83bc6e5cba44cf69b3b9ee659e01d8d",
          "localConnectionString": "postgresql://dummy:dummy@localhost:5432/dummy",
          // Keep secrets out of source control:
          // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in your shell/.dev.vars for local wrangler dev.
        },
        {
          "binding": "HYPERDRIVE_NO_CACHE",
          "id": "3f718e896f60459d8810ba32b7069eac",
          "localConnectionString": "postgresql://dummy:dummy@localhost:5432/dummy",
          // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_NO_CACHE in .dev.vars for local dev.
        },
      ],
      // optionally add routes, vars, bindings specific to preview
    },
    "production": {
      "name": "doj-files",
    },
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f83bc6e5cba44cf69b3b9ee659e01d8d",
      "localConnectionString": "postgresql://dummy:dummy@localhost:5432/dummy",
      // Keep secrets out of source control:
      // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in your shell/.dev.vars for local wrangler dev.
    },
    {
      "binding": "HYPERDRIVE_NO_CACHE",
      "id": "3f718e896f60459d8810ba32b7069eac",
      "localConnectionString": "postgresql://dummy:dummy@localhost:5432/dummy",
      // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_NO_CACHE in .dev.vars for local dev.
    },
  ],
}
